---
import logo from '../assets/glaze.svg?url';
---

<a
  href={import.meta.env.BASE_URL}
  class="site-title glaze-site-title"
  aria-label="Glaze documentation home"
>
  <img src={logo} width="32" height="32" alt="" />
  <span>Glaze</span>
</a>

<style>
  .glaze-site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .glaze-site-title img {
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
  }
</style>

<style is:global>
  /*
    The logo is drawn with a black outer ring, which disappears against the
    dark surface. Trace the circle in white so the silhouette survives.
  */
  [data-theme='dark'] .glaze-site-title img {
    border-radius: 50%;
    box-shadow: 0 0 0 1px #fff;
  }

  [data-theme='dark'] .sl-markdown-content img[src='assets/glaze.svg'] {
    border-radius: 50%;
    box-shadow: 0 0 0 2px #fff;
  }
</style>
