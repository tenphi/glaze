---
import logo from '../assets/glaze.svg?url';
---

<a
  href={import.meta.env.BASE_URL}
  class="site-title glaze-site-title"
  aria-label="Glaze documentation home"
>
  <img src={logo} width="32" height="32" alt="" />
  <span>Glaze</span>
</a>

<style>
  .glaze-site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .glaze-site-title img {
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
  }
</style>
